# Copy to .env.local (or set in your hosting dashboard)

# Your live domain, no trailing slash. Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.resizephotoinkb.com

# Leave empty until AdSense gives you a publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional: ad unit slot ID for the in-article ad on blog posts (after approval)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Supabase (blog + admin panel). From Supabase → Project Settings → API.
# Until these are set, /blog shows "coming soon" and /admin shows setup steps.
# Use the publishable key (sb_publishable_...) or the legacy anon key. NEVER put the
# secret / service_role key here: NEXT_PUBLIC_ values are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase → Connect → Session pooler connection string.
# Used by `npm run db:setup` and to sync the admin login below. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Blog admin login for /admin/login. This file is the source of truth: change either
# value and restart the server (or run `npm run admin:sync`) and Supabase is updated.
# Changing the password signs out existing sessions. Min 6 characters (12+ recommended); avoid "$".
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
